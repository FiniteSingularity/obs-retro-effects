uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 uv_size;

uniform float luma_band_size;
uniform float luma_band_strength;
uniform int luma_band_count;
uniform float luma_band_asymmetry;

uniform float chroma_bleed_size;
uniform int chroma_bleed_steps;
uniform float chroma_bleed_strength;
uniform float chroma_bleed_saturation;
uniform float chroma_bleed_hue_shift;
uniform float chroma_bleed_directionality;

uniform float dot_crawl_speed;
uniform float dot_crawl_amount;
uniform float comb_filter_strength;

uniform float elapsed_time;

uniform float saturation;
uniform float brightness;

#define PI  3.1415926535
#define TAU 6.2831853071
#define EPS 1.e-8

float3 yiq2rgb(float3 c) {
	return float3(
		dot(c, float3(1.0,  0.9560,  0.6210)),
		dot(c, float3(1.0, -0.2720, -0.6474)),
		dot(c, float3(1.0, -1.1060,  1.7046))
	);
}

float decay_wave(float x, float cycles)
{
	float env = (1.0 - x) * (1.0 - x);
	return cos(x * PI * cycles) * env;
}

float2 chroma_iq(float2 yz)
{
	float ph = yz.y * TAU - PI;
	return yz.x * float2(cos(ph), sin(ph));
}

sampler_state textureSampler{
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
    MinLOD = 0;
    MaxLOD = 0;
};

struct VertData
{
	float4 pos : POSITION;
	float2 uv : TEXCOORD0;
};

VertData mainTransform(VertData v_in)
{
	v_in.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	return v_in;
}

float4 mainImage(VertData v_in) : TARGET
{
	float2 coord = v_in.uv * uv_size;
	float4 ntsc = image.Sample(textureSampler, v_in.uv);

	// Denormalize the current point's phase angle
	ntsc.z = ntsc.z * TAU - PI;

	// *** Luminance Banding ***
	// Simulates luminance banding with adjustable number of bands.
	// Uses cos(x*pi*cycles) * (1.0 - x) as a decaying wave function
	// Samples surrounding pixels, and applies decaying wave
	// convolution to generate luma bands around high contrast areas.

	// luma_band_asymmetry: 0 = symmetric (current look), 1 = fully causal/trailing
	
	// Echo lands opposite the boosted tap, so to trail RIGHT we weight the LEFT taps more.
	float w_right = 1.0 + luma_band_asymmetry; // -> applied to l2 (coord - i): echo trails RIGHT
	float w_left = 1.0 - luma_band_asymmetry; // -> applied to l1 (coord + i)
	
	float luma_band = ntsc.x;
	float luma_coef_sum = 1.0;
	for (int i = 1; i <= luma_band_size; i++)
	{
		float2 step = float2(float(i), 0.0);
		// Sample at +/- i step
		float l1 = image.Sample(textureSampler, (coord + step) / uv_size).x;
		float l2 = image.Sample(textureSampler, (coord - step) / uv_size).x;
		// Get sample weight from decaying cos wave function
		float coef = decay_wave(float(i) / luma_band_size, luma_band_count);
		luma_coef_sum += coef * (w_left + w_right);
		// Sum samples * their weight.
		luma_band += (l1 * w_left + l2 * w_right) * coef;
	}
	// Normalize weighted sum by sum of weights used.
	luma_band /= luma_coef_sum;
	// Apply luma_band value scaled by luma_band_strength value
	ntsc.x = (1.0 - luma_band_strength) * ntsc.x + luma_band_strength * luma_band;

	// *** Chroma Bleed *** (averaged in I/Q vector space, wrap-safe)
	// Switched to I/Q space to avoid phase wrap issues when sampling neighboring pixels
	// Use a smoothstep convolution to sample surrounding pixels.
	float2 iq_center = ntsc.y * float2(cos(ntsc.z), sin(ntsc.z));

	float chroma_coef_sum = 1.0; // center anchored at weight 1.0
	float2 chroma_bleed = iq_center;
	float step_size = chroma_bleed_size / float(chroma_bleed_steps);
	for (int i = 1; i <= chroma_bleed_steps; i++)
	{
		float2 step = float2(float(i) * step_size, 0.0);
		float2 c1 = image.Sample(textureSampler, (coord + step) / uv_size).yz;
		float2 c2 = image.Sample(textureSampler, (coord - step) / uv_size).yz;
		c1.y = c1.y * TAU - PI;
		c2.y = c2.y * TAU - PI;
		float2 v1 = c1.x * float2(cos(c1.y), sin(c1.y));
		float2 v2 = c2.x * float2(cos(c2.y), sin(c2.y));

		float coef = smoothstep(0.0, 1.0, 1.0 - float(i) / float(chroma_bleed_steps));

	// Weight each neighbor by its OWN chroma, never by a comparison to the
	// center. Neutral neighbors get ~0 weight (can't desaturate us); saturated
	// neighbors get full weight (bleed into us). No center_mag reference ->
	// no iso-saturation contours -> no banding.
		float w1 = coef * pow(max(c1.x, 1e-5), chroma_bleed_directionality);
		float w2 = coef * pow(max(c2.x, 1e-5), chroma_bleed_directionality);

		chroma_coef_sum += w1 + w2;
		chroma_bleed += v1 * w1 + v2 * w2;
	}
	chroma_bleed /= chroma_coef_sum;

	// The fringe: how much neighbors shifted us away from our own chroma.
	float2 delta = chroma_bleed - iq_center;

	// Apply the character settings to the fringe ONLY.
	delta *= chroma_bleed_saturation; // oversaturate the fringe

	float bs, bc;
	sincos(chroma_bleed_hue_shift, bs, bc); // rotate the fringe's hue
	delta = float2(delta.x * bc - delta.y * bs,
	               delta.x * bs + delta.y * bc);

	float2 bled = iq_center + delta;
	float2 iq = lerp(iq_center, bled, chroma_bleed_strength);
	
	// *** Dot Crawl ***
	// A comb decoder cancels the chroma subcarrier in luma wherever chroma matches
	// line-to-line, so dots only survive at vertical chroma edges. The residual left
	// in luma is the line-to-line chroma difference projected onto the carrier.
	// Flat color -> difference ~0 -> no dots. Edge -> dots that crawl with time.
	float2 iq_left = chroma_iq(image.Sample(textureSampler, (coord - float2(1.0, 0.0)) / uv_size).yz);
	float2 comb_residual = iq_center - iq_left; // perfect comb: only edges leak
	// comb_filter_strength: 1 = comb (dots at edges only), 0 = notch (dots wherever chroma exists)
	float2 gate = lerp(iq_center, comb_residual, comb_filter_strength);
	
	// Carrier: fine horizontal dots, but sub-Nyquist vertical so the pattern
	// crawls (translates) over time instead of amplitude-modulating (blinking).
	float carrier = PI * coord.x                        // fine horizontal dots
	               + 2.25 * coord.y                     // sub-Nyquist vertical -> can crawl
	               + elapsed_time * dot_crawl_speed;    // continuous vertical crawl

	// Leaked residual = line-to-line chroma difference projected onto the carrier.
	float residual = 0.5 * (gate.x * cos(carrier) + gate.y * sin(carrier));
	ntsc.x += dot_crawl_amount * residual;

	// Apply receiver brightness and saturation adjustments.
	ntsc.x *= brightness;
	iq *= saturation;
	
	// Reconstruct yiq values from ntsc luminance (.x), iq length (.y), and phase angle (.z).
	// Luminance passes through as Y
	// I = cos(phase)*iq_length
	// Q = sin(phase)*iq_length
	float3 yiq = float3(ntsc.x, iq.x, iq.y);

	// Convert YIQ to RGB and return.  Alpha is passed through from original source.
	return float4(yiq2rgb(yiq), ntsc.a);
}

technique Draw
{
	pass
	{
		vertex_shader = mainTransform(v_in);
		pixel_shader = mainImage(v_in);
	}
}
