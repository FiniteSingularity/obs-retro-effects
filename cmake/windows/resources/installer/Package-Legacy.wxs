<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="$(var.ProductDisplayName) (Legacy)"
    Manufacturer="$(var.ProductAuthor)"
    Version="$(var.MsiVersion)"
    UpgradeCode="8B93AFF4-51BF-4B16-BA63-F06C4B8DA75A"
    Language="1033"
    Scope="perMachine"
    InstallerVersion="500">

    <SummaryInformation
      Description="$(var.ProductDisplayName) $(var.ProductVersion) for OBS Studio 28 - 32 (legacy plugin layout)"
      Manufacturer="$(var.ProductAuthor)" />

    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of $(var.ProductDisplayName) (Legacy) is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="$(var.ProductWebsite)" />
    <Property Id="ARPHELPLINK" Value="$(var.ProductWebsite)" />

    <Property Id="OBS_INSTALL_PATH_64">
      <RegistrySearch Id="ObsInstallPath64" Root="HKLM" Key="SOFTWARE\OBS Studio" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="OBS_INSTALL_PATH_32">
      <RegistrySearch Id="ObsInstallPath32" Root="HKLM" Key="SOFTWARE\OBS Studio" Type="raw" Bitness="always32" />
    </Property>
    <Property Id="SAVED_INSTALLFOLDER">
      <RegistrySearch Id="SavedInstallFolder" Root="HKLM" Key="SOFTWARE\$(var.ProductAuthor)\$(var.ProductName) Legacy" Name="InstallFolder" Type="raw" Bitness="always64" />
    </Property>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="obs-studio" />
    </StandardDirectory>

    <CustomAction Id="SetInstallFolderFromSaved" Property="INSTALLFOLDER" Value="[SAVED_INSTALLFOLDER]" />
    <CustomAction Id="SetInstallFolderFromRegistry64" Property="INSTALLFOLDER" Value="[OBS_INSTALL_PATH_64]" />
    <CustomAction Id="SetInstallFolderFromRegistry32" Property="INSTALLFOLDER" Value="[OBS_INSTALL_PATH_32]" />

    <InstallUISequence>
      <Custom Action="SetInstallFolderFromSaved" After="AppSearch" Condition="NOT INSTALLFOLDER AND SAVED_INSTALLFOLDER" />
      <Custom Action="SetInstallFolderFromRegistry64" After="SetInstallFolderFromSaved" Condition="NOT INSTALLFOLDER AND OBS_INSTALL_PATH_64" />
      <Custom Action="SetInstallFolderFromRegistry32" After="SetInstallFolderFromRegistry64" Condition="NOT INSTALLFOLDER AND OBS_INSTALL_PATH_32" />
    </InstallUISequence>

    <InstallExecuteSequence>
      <Custom Action="SetInstallFolderFromSaved" After="AppSearch" Condition="NOT INSTALLFOLDER AND SAVED_INSTALLFOLDER" />
      <Custom Action="SetInstallFolderFromRegistry64" After="SetInstallFolderFromSaved" Condition="NOT INSTALLFOLDER AND OBS_INSTALL_PATH_64" />
      <Custom Action="SetInstallFolderFromRegistry32" After="SetInstallFolderFromRegistry64" Condition="NOT INSTALLFOLDER AND OBS_INSTALL_PATH_32" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="$(var.ProductDisplayName) (Legacy)" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="PluginFiles" />
      <ComponentRef Id="InstallState" />
    </Feature>

    <!-- Everything the cmake install step staged for the portable legacy layout: obs-plugins\64bit\**, data\obs-plugins\<plugin>\** -->
    <ComponentGroup Id="PluginFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.StagingDir)\**" />
    </ComponentGroup>

    <Component Id="InstallState" Directory="INSTALLFOLDER" Guid="F258B60D-3429-4C97-B9DD-2523EED28012" Bitness="always64">
      <RegistryKey Root="HKLM" Key="SOFTWARE\$(var.ProductAuthor)\$(var.ProductName) Legacy" ForceDeleteOnUninstall="yes">
        <RegistryValue Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RegistryValue Name="Version" Type="string" Value="$(var.ProductVersion)" />
      </RegistryKey>
    </Component>

    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>
</Wix>
